# Copy this to .env and fill in the blanks. line.mjs and imessage_mcp.py read the same file.

# ── Spectrum / Photon line credentials (required) ──────────────
# Get these from https://app.photon.codes → your project → Settings.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# ── The person you're chatting with (required) ─────────────────
OWNER_PHONE=+8613800000000
OWNER_NAME=them

# ── Local door + MCP auth (required) ───────────────────────────
# SEND_TOKEN: shared secret between line.mjs and the MCP layer (the "door").
# MCP_TOKEN: bearer token clients must send to reach the MCP server.
SEND_TOKEN=
MCP_TOKEN=
DOOR_PORT=18230
PORT=8515
PUBLIC_HOST=imessage.example.com

# ── Optional: speech-to-text for incoming voice notes ──────────
# With no ASR_PROVIDER set, ElevenLabs Scribe is used when ELEVENLABS_API_KEY is present,
# otherwise the OpenAI-compatible endpoint below is used.
# ASR_PROVIDER=elevenlabs        # or openai
# ASR_MODEL=scribe_v1            # scribe_v1 for elevenlabs; whisper-large-v3 for openai
# ASR_LANG=zh
# ASR_API_KEY=                   # only for the openai path
# ASR_BASE_URL=https://api.groq.com/openai/v1

# ── Optional: your own voice (the [[voice:…]] action uses this key too) ──
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v3
# VOICE_NAME=assistant

# ── Optional: tone detection for incoming voice notes ──────────
# Runs through Alibaba DashScope. Failure silently degrades (transcript is unaffected).
# Set TONE=0 to disable entirely.
# DASHSCOPE_API_KEY=sk-...
# Free quota is per-model; comma-separated, falls through to the next on exhaustion.
# TONE_MODEL=qwen3.8-omni-flash,qwen-omni-turbo
# TONE_TIMEOUT_MS=25000
# TONE_PROMPT=

# ── Optional ──────────────────────────────────────────────────
# MAX_INBOX=500
